{
  "name": "unicorn",
  "version": "1.0.0-rc.3",
  "private": true,
  "description": "A secure Windows workspace for isolated Chromium browser quality assurance",
  "author": "OxSagar",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OxSagar/unicorn.git"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts *.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
